Cell[BoxData[
 RowBox[{
  RowBox[{"mape", "[", 
   RowBox[{"prediction_", ",", "actual_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"APE", ",", "n", ",", "MAPE"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "actual", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"APE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"100", " ", "*", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"actual", "[", 
