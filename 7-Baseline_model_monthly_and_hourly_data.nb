Cell[BoxData[
 RowBox[{
  RowBox[{"smape", "[", 
   RowBox[{"prediction_", ",", "actual_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sAPE", ",", "n", ",", "sMAPE"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "actual", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sAPE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"100", " ", "*", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"actual", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", 
            RowBox[{"prediction", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"actual", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "+", 
            RowBox[{"Abs", "[", 
             RowBox[{"prediction", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sMAPE", "=", 
      RowBox[{"2", "*", " ", 
       RowBox[{"Mean", "[", "sAPE", "]"}]}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.930708264397644*^9, 3.930708369991228*^9}, {
   3.930708450211168*^9, 3.930708464042732*^9}, 3.930708523543892*^9, {
   3.930815383408556*^9, 3.930815388834448*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"6b15fbf3-99e1-964f-b3e5-253b4023c8c5"]
}, Open  ]],

