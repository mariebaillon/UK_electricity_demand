Cell[BoxData[
 RowBox[{
  RowBox[{"smape", "[", 
   RowBox[{"prediction_", ",", "actual_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sAPE", ",", "n", ",", "sMAPE"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "actual", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sAPE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"100", " ", "*", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"actual", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", 
            RowBox[{"prediction", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"actual", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "+", 
            RowBox[{"Abs", "[", 
             RowBox[{"prediction", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sMAPE", "=", 
      RowBox[{"2", "*", " ", 
       RowBox[{"Mean", "[", "sAPE", "]"}]}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.930708264397644*^9, 3.930708369991228*^9}, {
   3.930708450211168*^9, 3.930708464042732*^9}, 3.930708523543892*^9, {
   3.930815383408556*^9, 3.930815388834448*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"e96b6837-7c08-0843-89b0-64510752ad48"]
}, Open  ]],

