Cell["\<\
The autocorrelation structure seems constant over time with a 52 weeks \
sequence. This indicates that the periodic components should be consistent \
and stable over time and that a Fourier analysis would give satisfactory \
results despite the non-stationarity of the signal.\
\>", "Text",
 CellChangeTimes->{{3.931332908994158*^9, 3.931332973792822*^9}, {
  3.9313330242210217`*^9, 3.9313330257181377`*^9}, {3.9313333039056797`*^9, 
