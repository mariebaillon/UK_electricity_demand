Cell[CellGroupData[{

Cell["5.1 Normalised weekly pattern", "Subsection",
 CellChangeTimes->{{3.931929590819591*^9, 3.931929610613001*^9}, 
   3.932020603698055*^9, 3.957343271228115*^9, 
   3.9573433272218266`*^9},ExpressionUUID->"31c9bf1a-f3b3-1444-8650-\
23dc5bcdb4f6"],

Cell["\<\
We take all the weeks  for year 2013 and we normalise the total load so that \
each week adds to 168 and so does the pattern.\
\>", "Text",
 CellChangeTimes->{{3.93201968089657*^9, 3.932019689721008*^9}, {
   3.9320197225220585`*^9, 3.932019755714279*^9}, {3.9320198048431435`*^9, 
