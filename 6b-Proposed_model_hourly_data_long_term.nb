659acc202f6d"],

Cell["\<\
To extract the trend and study other fluctuations (>1week), we build the \
weekly time series by directly taking the means of hourly data within a time \
window of 1 week.\
\>", "Text",
 CellChangeTimes->{{3.932005891278242*^9, 3.93200591160095*^9}, {
  3.932028858124531*^9, 3.9320288609023857`*^9}, {3.9321035196562805`*^9, 
  3.9321035575262814`*^9}, {3.932103599724684*^9, 
  3.932103622714615*^9}},ExpressionUUID->"aa31ffc1-cd64-c449-81de-\
41ef2208d62b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"weeklyMean", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Mean", "[", "#", "]"}], "&"}], "/@", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"hourlyDemandTS", "[", "\"\<Values\>\"", "]"}], ",", "168"}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.931940047256592*^9, 3.9319401090020733`*^9}, 
   3.93194703472983*^9, {3.932005920439024*^9, 3.932005922259159*^9}, 
   3.932006737932068*^9, 3.932028886044012*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"466cb083-d3a4-0f44-983e-19256eab4c1c"],

