Cell[CellGroupData[{

Cell["\<\
4.3.3 Time lag adjustment and number of Fourier components optimisation\
\>", "Subsubsection",
 CellChangeTimes->{{3.930644619173018*^9, 3.930644624806452*^9}, {
   3.930738474130541*^9, 3.930738476918199*^9}, 3.931336613740902*^9, {
   3.931342695221428*^9, 3.931342713502851*^9}, 3.932036356207094*^9, 
   3.957343322791399*^9},ExpressionUUID->"787cfbd3-a9e7-c041-9325-\
5c2f51637655"],

Cell["\<\
For this cyclic model there seems to be a link between the time lag and the \
number of Fourier component which was not the case in the other cyclic \
models. Let\[CloseCurlyQuote]s study both parameters at once.\
\>", "Text",
 CellChangeTimes->{{3.930714303728529*^9, 3.930714395842955*^9}, {
  3.930886414831485*^9, 3.930886467608208*^9}, {3.932109319550508*^9, 
  3.932109323980083*^9}, {3.932110168630129*^9, 3.9321102548149815`*^9}, {
  3.932736284396448*^9, 
  3.932736290831373*^9}},ExpressionUUID->"2e17938c-ccd9-0f48-9564-\
f27de73e3fd7"],

