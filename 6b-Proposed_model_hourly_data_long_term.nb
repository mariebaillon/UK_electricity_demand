Cell[BoxData[
 RowBox[{
  RowBox[{"mase", "[", 
   RowBox[{"prediction_", ",", "actual_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Q", ",", "n", ",", "MASE"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "actual", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Q", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"actual", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", 
          RowBox[{"prediction", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MASE", "=", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Abs", "[", "Q", "]"}], "]"}], "/", 
       RowBox[{"Mean", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Differences", "[", "actual", "]"}], "]"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.930640782223762*^9, 3.930640801012134*^9}, {
  3.930641974417501*^9, 3.930642064421325*^9}, {3.930642322616691*^9, 
  3.930642330984537*^9}, {3.93064237272804*^9, 3.930642375112819*^9}, {
  3.930642491037119*^9, 3.930642495076524*^9}, {3.930644100895819*^9, 
  3.930644114774168*^9}, {3.930707970600223*^9, 3.930707989407931*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"fb85bf77-d953-c841-a6ba-004a763e6cac"]
}, Open  ]]
}, Closed]],

