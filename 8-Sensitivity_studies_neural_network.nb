Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"demandNet2Plus", "=", 
   RowBox[{"NetChain", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"BatchNormalizationLayer", "[", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "5", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ElementwiseLayer", "[", "\"\<ReLU\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"DropoutLayer", "[", "0.1", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "20", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ElementwiseLayer", "[", "\"\<ReLU\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Output\>\"", "->", "\"\<Real\>\""}], ",", 
     RowBox[{"\"\<Input\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"8", ",", "14"}], "}"}]}]}], "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.9297007667490616`*^9, 3.929700813119943*^9}, {
   3.929700893169508*^9, 3.9297009023269215`*^9}, {3.929700974035745*^9, 
