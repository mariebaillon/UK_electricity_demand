Cell["Improved MLP with 18/2/20 neurons per liner layer", "Text",
 CellChangeTimes->{{3.931691575805973*^9, 
  3.9316915825640354`*^9}},ExpressionUUID->"dc123ee5-c6fa-d64e-8090-\
4e6bd3dd48a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"demandNet4Plus", "=", 
   RowBox[{"NetChain", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"BatchNormalizationLayer", "[", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "18", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ElementwiseLayer", "[", "\"\<ReLU\>\"", "]"}], ",", 
