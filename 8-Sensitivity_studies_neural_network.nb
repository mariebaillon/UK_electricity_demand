Cell[BoxData[
 RowBox[{
  RowBox[{"demandNetPlus", "=", 
   RowBox[{"NetChain", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"BatchNormalizationLayer", "[", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "18", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ElementwiseLayer", "[", "\"\<ReLU\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"DropoutLayer", "[", "0.1", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "40", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ElementwiseLayer", "[", "\"\<ReLU\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LinearLayer", "[", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Output\>\"", "->", "\"\<Real\>\""}], ",", 
     RowBox[{"\"\<Input\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"8", ",", "14"}], "}"}]}]}], "]"}]}], "\n"}]], "Input",
