Cell[BoxData[
 RowBox[{"demandLTSM", "=", 
  RowBox[{"NetChain", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"LongShortTermMemoryLayer", "[", "50", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"SequenceLastLayer", "[", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ReplicateLayer", "[", "4", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"LongShortTermMemoryLayer", "[", "7", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"NetMapOperator", "[", 
       RowBox[{"LinearLayer", "[", "5", "]"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"SoftmaxLayer", "[", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "18", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ElementwiseLayer", "[", "LogisticSigmoid", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "40", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ElementwiseLayer", "[", "LogisticSigmoid", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "40", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ElementwiseLayer", "[", "\"\<ReLU\>\"", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "]"}]}], "}"}], ",", 
    RowBox[{"\"\<Output\>\"", "->", "\"\<Real\>\""}], ",", 
    RowBox[{"\"\<Input\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"8", ",", "14"}], "}"}]}]}], "]"}]}]], "Input",
