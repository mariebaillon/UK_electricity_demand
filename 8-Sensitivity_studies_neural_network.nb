ffb7ebb6d6e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fuel09to24", "=", 
   RowBox[{"Import", "[", "\"\<exp_fuel09to24.csv\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fuel09to24DS", "=", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"fuel09to24", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", 
        RowBox[{"ToExpression", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
     RowBox[{"fuel09to24", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dailyAvgRenPerc09to23", "=", 
   RowBox[{
    RowBox[{"Query", "[", 
     RowBox[{
      RowBox[{"GroupBy", "[", "\"\<SETTLEMENT_DATE\>\"", "]"}], ",", " ", 
      "Mean", ",", " ", "\"\<RENEWABLE_perc\>\""}], "]"}], "[", 
    "fuel09to24DS", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"dailyAvgRenPerc09to23TS", "=", 
  RowBox[{"TimeSeries", "[", 
   RowBox[{"dailyAvgRenPerc09to23", "//", "Normal"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"trendRenPerc09to23TS", "=", 
  RowBox[{"MeanFilter", "[", 
   RowBox[{"dailyAvgRenPerc09to23TS", ",", 
    RowBox[{"Quantity", "[", 
     RowBox[{"12", ",", "\"\<Months\>\""}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.92820620427512*^9, 3.928206261972157*^9}, 
