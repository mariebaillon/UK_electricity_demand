Cell[BoxData[
 RowBox[{
  RowBox[{"inputMatrix1Training", "[", "n_", "]"}], ":=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SparseArray", "[", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"j", ",", "1"}], "}"}], "->", 
          RowBox[{"variables1Norm", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", "variables1Norm", "]"}]}], "}"}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "variables1Norm", "]"}], "+", "1"}], ",", 
            "j"}], "}"}], "->", 
          RowBox[{
           RowBox[{"TNComponentNorm", "[", "\"\<Values\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"i", "-", "n", "+", "j", "-", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2", ",", 
           RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"155", "-", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"155", "-", 
            RowBox[{"2", "n"}], "-", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}]}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}]}], ",", 
      RowBox[{"155", "-", "35", "-", 
       RowBox[{"2", "n"}], "-", "1", "-", 
       RowBox[{"(", 
        RowBox[{"24", "-", 
