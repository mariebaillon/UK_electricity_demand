Cell[BoxData[
 RowBox[{
  RowBox[{"mase", "[", 
   RowBox[{"prediction_", ",", "actual_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Q", ",", "n", ",", "MASE"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "actual", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Q", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"actual", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", 
          RowBox[{"prediction", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MASE", "=", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Abs", "[", "Q", "]"}], "]"}], "/", 
       RowBox[{"Mean", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Differences", "[", "actual", "]"}], "]"}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.930640782223762*^9, 3.930640801012134*^9}, {
  3.930641974417501*^9, 3.930642064421325*^9}, {3.930642322616691*^9, 
  3.930642330984537*^9}, {3.93064237272804*^9, 3.930642375112819*^9}, {
  3.930642491037119*^9, 3.930642495076524*^9}, {3.930644100895819*^9, 
  3.930644114774168*^9}, {3.930707970600223*^9, 3.930707989407931*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"fb85bf77-d953-c841-a6ba-004a763e6cac"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["1.3 Import all independent variables datasets", "Subsection",
 CellChangeTimes->{{3.928205852632056*^9, 3.9282058634920254`*^9}, {
  3.930725642657039*^9, 3.9307256434878025`*^9}, {3.944893011125044*^9, 
  3.9448930171397724`*^9}},ExpressionUUID->"b53b44b8-a0e4-4348-ae52-\
67f01df6a3f7"],

Cell[CellGroupData[{

Cell["SBP price", "Subsubsection",
 CellChangeTimes->{{3.9282059890028267`*^9, 
  3.928205995721887*^9}},ExpressionUUID->"b22fbbd3-0360-8c47-aba3-\
0060e4582242"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prices01to24", "=", 
   RowBox[{"Import", "[", "\"\<exp_prices01to24.csv\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"prices01to24DS", "=", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"prices01to24", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", 
        RowBox[{"ToExpression", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
     RowBox[{"prices01to24", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dailyAvgSBP01to24", "=", 
   RowBox[{
    RowBox[{"Query", "[", 
     RowBox[{
      RowBox[{"GroupBy", "[", "\"\<SETTLEMENT_DATE\>\"", "]"}], ",", " ", 
      "Mean", ",", " ", "\"\<SBP\>\""}], "]"}], "[", "prices01to24DS", 
    "]"}]}], ";"}], "\n", 
 RowBox[{"dailyAvgSBP01to24TS", "=", 
  RowBox[{"TimeSeries", "[", 
   RowBox[{"dailyAvgSBP01to24", "//", "Normal"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"trendSBP01to24TS", "=", 
  RowBox[{"MeanFilter", "[", 
   RowBox[{"dailyAvgSBP01to24TS", ",", 
    RowBox[{"Quantity", "[", 
     RowBox[{"12", ",", "\"\<Months\>\""}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.928205901887387*^9, 3.928205911174921*^9}, {
  3.9282059598126755`*^9, 3.928205960332423*^9}, {3.928206906566284*^9, 
  3.928206927063404*^9}, {3.932725635377794*^9, 3.93272563583168*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"376d456a-f95d-6943-81e8-251f2382b901"],

