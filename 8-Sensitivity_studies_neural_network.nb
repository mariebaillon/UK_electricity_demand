Cell[CellGroupData[{

Cell["\<\
5.5.5 Dataset matrix with independent variables, with differencing and \
normalisation of the data\
\>", "Subsubsection",
 CellChangeTimes->{{3.929701876994858*^9, 3.929701880064928*^9}, {
   3.930738929906349*^9, 3.93073893359469*^9}, 3.9307973621957836`*^9, {
