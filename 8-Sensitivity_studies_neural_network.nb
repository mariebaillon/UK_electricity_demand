Cell[BoxData[{
 RowBox[{
  RowBox[{"avgTemp09to22", "=", 
   RowBox[{"Import", "[", "\"\<exp_temp09to22.csv\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"avgTemp09to22TS", "=", 
   RowBox[{"TimeSeries", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ToExpression", "[", "#", "]"}], "&"}], "/@", "avgTemp09to22"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"trendTemp09to22", "=", 
  RowBox[{"MeanFilter", "[", 
   RowBox[{"avgTemp09to22TS", ",", 
    RowBox[{"Quantity", "[", 
     RowBox[{"12", ",", "\"\<Months\>\""}], "]"}]}], "]"}]}]}], "Input",
