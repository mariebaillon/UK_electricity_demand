            RowBox[{"9", ",", "0.0905"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"9", ",", "0.092"}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
