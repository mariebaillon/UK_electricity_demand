Cell["Forecast model for cycles:", "Text",
 CellChangeTimes->{{3.931257964507475*^9, 3.9312579739885406`*^9}, {
  3.932718783934986*^9, 
  3.932718786150854*^9}},ExpressionUUID->"f442c101-a570-5444-8835-\
74caee80b49c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"forecastCyclic1", "[", 
   RowBox[{"t_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "iFFTCos", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"iFFTCos", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cyclic1Components", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"2", "*", "Pi", "*", 
            RowBox[{"cyclic1Components", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "*", "t"}], "+", 
           RowBox[{"cyclic1Components", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "]"}]}], ",", 
