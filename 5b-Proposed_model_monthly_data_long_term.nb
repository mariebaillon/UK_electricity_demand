Cell[CellGroupData[{

Cell["3.4.3 Time lag adjustment", "Subsubsection",
 CellChangeTimes->{{3.930644582775131*^9, 3.930644594485962*^9}, {
  3.9307257722795715`*^9, 3.930725775950194*^9}, {3.931258312537788*^9, 
  3.931258320162445*^9}},ExpressionUUID->"962a9bc7-f956-4d45-8d2f-\
55b4ce47f304"],

Cell["\<\
We notice that the peaks of the forecast series are shifted compared to the \
peaks of the demand time series. Let\[CloseCurlyQuote]s find the shift first. 
The number of Fourier components is arbitrarily set to 5 components and we \
calculate the MAPE for each value of the time shift.\
\>", "Text",
 CellChangeTimes->{{3.930714303728529*^9, 3.930714395842955*^9}, {
  3.9308864148314853`*^9, 3.9308864676082087`*^9}, {3.946110215331888*^9, 
  3.946110252198488*^9}, {3.946110287164564*^9, 3.946110316140295*^9}, {
  3.9462928021608505`*^9, 
  3.9462928023271904`*^9}},ExpressionUUID->"db7d1dda-8212-4849-8c88-\
c341c6447af4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
