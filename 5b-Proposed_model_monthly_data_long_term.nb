Cell["\<\
The signal has periodic fluctuations and as we have seen in section 2, the \
standard deviation of the fluctuations is not constant over time, this means \
that the signal is not stationary as confirmed by the UnitRootTest.\
\>", "Text",
 CellChangeTimes->{{3.929508274311487*^9, 3.929508280465669*^9}, {
  3.930633429948292*^9, 3.930633430468889*^9}, {3.9312565625312576`*^9, 
  3.9312566260832577`*^9}, {3.9313328101735573`*^9, 
  3.93133290178314*^9}},ExpressionUUID->"d4c2fd3a-09fa-bb48-840d-\
4b6b126d1325"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UnitRootTest", "[", "monthlyFluctuationsNormTS", "]"}]], "Input",
 CellChangeTimes->{{3.929508109111101*^9, 3.929508119301918*^9}, {
   3.9295081566105995`*^9, 3.929508159014253*^9}, {3.92950825360487*^9, 
