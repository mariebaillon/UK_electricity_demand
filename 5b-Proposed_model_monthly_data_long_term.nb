    RowBox[{
     RowBox[{"nextPrediction", "=", 
      RowBox[{"demandNetOGTrained", "[", "inputVector", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"outputVector", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Rest", "[", "inputVector", "]"}], ",", 
        RowBox[{"{", "nextPrediction", "}"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
