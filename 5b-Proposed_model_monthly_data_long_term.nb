d45084d6b61e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"mape", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"forecastCyclic1", "[", 
        RowBox[{"#", ",", "6"}], "]"}], ")"}], "&"}], "/@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"monthlyFluctuationsNormTS", "[", "\"\<Times\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;", "120"}], "]"}], "]"}], ")"}]}], "]"}], ",", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"monthlyFluctuationsNormTS", "[", "\"\<Values\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{";;", 
       RowBox[{"120", "-", "2"}]}], "]"}], "]"}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"mase", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
