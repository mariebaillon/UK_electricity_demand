Cell["The forecast is shifted compared to observed data.", "Text",
 CellChangeTimes->{{3.946106221754198*^9, 3.9461062301826057`*^9}, {
  3.946109773015398*^9, 
  3.946109789225107*^9}},ExpressionUUID->"2d271019-4bfa-ec46-8aea-\
