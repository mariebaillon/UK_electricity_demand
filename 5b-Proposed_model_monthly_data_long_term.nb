Cell["\<\
The model for the long-term trend and short-term variability is optimised on \
the training period data and validated over the validation period data. The \
normalisation parameters are derived for these periods.\
\>", "Text",
 CellChangeTimes->{{3.955958650898527*^9, 3.9559586750648155`*^9}, {
  3.955958725574356*^9, 3.9559587435916767`*^9}, {3.955958860021309*^9, 
  3.9559588932932167`*^9}, {3.9559615093193913`*^9, 3.95596154194034*^9}, {
  3.9560534834789944`*^9, 
  3.9560534850079575`*^9}},ExpressionUUID->"628d8ccb-969c-484b-9eb4-\
bff7f6d14792"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"meanNN", "=", 
   RowBox[{"Mean", "[", "TNComponentTSTraining", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdevNN", "=", 
   RowBox[{"StandardDeviation", "[", "TNComponentTSTraining", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.955965867678097*^9, 3.955965916034546*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"e74c28de-e000-8149-8744-78e505d98fb0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TNComponentNorm", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"TNComponentTS", "-", "meanNN"}], ")"}], "/", 
   "stdevNN"}]}]], "Input",
