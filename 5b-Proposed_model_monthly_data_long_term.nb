Cell["\<\
A shift of 13 time steps seems to be needed between the forecast and and the \
actual time series.
Let\[CloseCurlyQuote]s then optimise the number of Fourier components needed \
to fit the time series.\
\>", "Text",
 CellChangeTimes->{{3.930886475215408*^9, 3.930886535715084*^9}, 
   3.93133679994343*^9},ExpressionUUID->"6eea40e0-dd0d-3a45-a6e6-\
5e3f7e0a2a85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"mape", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"forecastCyclic2", "[", 
              RowBox[{"#", ",", "n"}], "]"}], ")"}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "remainingFluctuationsNormTS", "[", "\"\<Times\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"14", ";;", "120"}], "]"}], "]"}], ")"}]}], "]"}], ",", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
           "remainingFluctuationsNormTS", "[", "\"\<Values\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"120", "-", "14"}]}], "]"}], "]"}], "]"}]}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", 
       RowBox[{"Length", "[", "peaksAmplitude2", "]"}]}], "}"}]}], "]"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<# Fourier\>\"", ",", "\"\<MAPE\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", "Blue"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", 
          RowBox[{"Thickness", "[", "0.001", "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Line", "[", 
