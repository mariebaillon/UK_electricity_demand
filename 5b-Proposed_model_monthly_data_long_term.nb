Cell[CellGroupData[{

Cell["\<\
3.4.4 Optimisation by varying the number of Fourier components\
\>", "Subsubsection",
 CellChangeTimes->{{3.930644619173018*^9, 3.930644624806452*^9}, {
  3.930725782155443*^9, 
  3.930725803684948*^9}},ExpressionUUID->"b29f49a0-9bff-3d43-b288-\
f1e9b74a58c7"],

Cell["\<\
The time lag is set at 1 month and we vary the number of Fourier components \
to find a minimum error.\
\>", "Text",
 CellChangeTimes->{{3.9461105368909016`*^9, 3.9461105798512516`*^9}},
 FontSize->14,ExpressionUUID->"5c776c9d-a8b6-604e-aa2c-ecb2dca0d67e"],

