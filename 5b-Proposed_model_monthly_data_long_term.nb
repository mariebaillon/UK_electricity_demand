Cell[CellGroupData[{

Cell["5.3 Dataset matrix without independent variables", "Subsection",
 CellChangeTimes->{{3.929701876994858*^9, 3.929701880064928*^9}, {
   3.930738929906349*^9, 3.93073893359469*^9}, 3.9307973621957836`*^9, {
   3.930802342177183*^9, 3.9308023632696667`*^9}, {3.93140056247719*^9, 
   3.931400562807257*^9}, 3.944893492128025*^9, 
   3.9568284829184437`*^9},ExpressionUUID->"5820c4fc-a542-e049-9125-\
fd86f03e55a6"],

Cell["\<\
The dataset is dependent on the size of the window chosen for historical \
data, i.e. the previous n months are selected to predict the n+1 electricity \
demand value.
The training dataset is 2009 to 2016, the validation dataset is 2017 - 2018 \
and the testing dataset is 2019 to 2021.\
\>", "Text",
 CellChangeTimes->{{3.930019837531296*^9, 3.930019919415828*^9}, {
   3.930020844518144*^9, 3.930020869899103*^9}, {3.930372533596941*^9, 
   3.9303725471130295`*^9}, 
   3.931432255510372*^9},ExpressionUUID->"148169ed-128a-1943-a1c7-\
c5eefec44e25"],

