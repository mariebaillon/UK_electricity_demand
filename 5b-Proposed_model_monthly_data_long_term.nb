Cell[CellGroupData[{

Cell["4.2.1 Isolate cycles", "Subsubsection",
 CellChangeTimes->{{3.9307118219252796`*^9, 3.930711830752653*^9}, {
   3.930734099068784*^9, 3.9307341021191025`*^9}, {3.930738119708139*^9, 
