Cell[CellGroupData[{

Cell["\<\
4.3.3 Time lag adjustment and number of Fourier components optimisation\
\>", "Subsubsection",
 CellChangeTimes->{{3.930644619173018*^9, 3.930644624806452*^9}, {
   3.930738474130541*^9, 3.930738476918199*^9}, 3.931336613740902*^9, {
   3.931342695221428*^9, 
   3.9313427135028515`*^9}},ExpressionUUID->"787cfbd3-a9e7-c041-9325-\
5c2f51637655"],

Cell["\<\
We notice that the peaks of the forecast series are shifted compared to the \
peaks of the demand time series. Let\[CloseCurlyQuote]s find the shift first.
The number of Fourier components is arbitrarily set at 6components and we \
calculate the MAPE for each value of the time shift.\
\>", "Text",
 CellChangeTimes->{{3.930714303728529*^9, 3.930714395842955*^9}, {
  3.9308864148314857`*^9, 3.9308864676082096`*^9}, {3.946112739997944*^9, 
  3.9461127430578175`*^9}},ExpressionUUID->"2e17938c-ccd9-0f48-9564-\
f27de73e3fd7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "-", "1"}], ",", 
       RowBox[{"mape", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"forecastCyclic2", "[", 
              RowBox[{"#", ",", "6"}], "]"}], ")"}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "remainingFluctuationsNormTS", "[", "\"\<Times\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"n", ";;", "120"}], "]"}], "]"}], ")"}]}], "]"}], ",", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{
           "remainingFluctuationsNormTS", "[", "\"\<Values\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{";;", 
             RowBox[{"120", "-", "n"}]}], "]"}], "]"}], "]"}]}], "]"}]}], 
      "}"}], ",", 
