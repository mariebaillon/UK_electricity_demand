Cell[CellGroupData[{

Cell["3.2 Scaling of the fluctuations", "Subsection",
 CellChangeTimes->{{3.930631204293609*^9, 3.930631211157412*^9}, {
  3.930725669160427*^9, 3.9307256700880146`*^9}, {3.9581086294079533`*^9, 
