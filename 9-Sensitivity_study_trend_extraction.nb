Cell[BoxData[
 RowBox[{"trendMean12A", "=", 
  RowBox[{"ListConvolve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", "12"}], "]"}], "/", "12"}], ",", 
    RowBox[{"Log", "[", "monthlyTotalDemandTS", "]"}], ",", "1", ",", 
