Cell[BoxData[
 RowBox[{
  RowBox[{"demand2009A", "=", 
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"monthlyTotalDemandTS", "[", "\"\<Values\>\"", "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", "12"}], "]"}], "]"}]}], ";"}]], "Input",
