Cell[CellGroupData[{

Cell["2.1.3 Low pass Gaussian filter", "Subsubsection",
 CellChangeTimes->{{3.929433328768637*^9, 3.929433335982043*^9}, {
  3.9294375812785625`*^9, 3.929437588287861*^9}, {3.9318489888177414`*^9, 
  3.9318489913517513`*^9}},ExpressionUUID->"8c70fb60-eb6b-2345-8af9-\
48e71c9d8ff1"],

Cell["\<\
We reach similar smoothing between box filter of radius r (i.e. arithmetic \
mean) and gaussian filter of radius 2r.\
\>", "Text",
 CellChangeTimes->{{3.9294376089049397`*^9, 
  3.9294376692070446`*^9}},ExpressionUUID->"b3858015-2325-c947-983b-\
4ce41b9a8ab4"],

