 TemplateBox[{
  "LocationEquivalenceTest", "vrnceql", 
   "\"At least one of the p-values in \\!\\(\\*RowBox[{\\\"{\\\", \
\\\"2.7659584831104934`*^-26\\\", \\\"}\\\"}]\\), resulting from a test for \
equal variances, is below \\!\\(\\*RowBox[{\\\"0.05`\\\"}]\\). The tests in \
\\!\\(\\*RowBox[{\\\"{\\\", \\\"\\\\\\\"KruskalWallis\\\\\\\"\\\", \
\\\"}\\\"}]\\) require that the data has equal variances.\"", 2, 718, 80, 
   20458828485953532964, "Local"},
