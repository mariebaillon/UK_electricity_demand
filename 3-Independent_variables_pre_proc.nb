Cell[BoxData[
 RowBox[{
  RowBox[{"preprocPipelineFuel", "=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "addNewColumn1", ",", "\[IndentingNewLine]", "addNewColumn2", ",", 
       "\[IndentingNewLine]", "convertToDataset"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"addNewColumn1", "[", "data_", "]"}], ":=", 
       RowBox[{"Module", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"newCol", ",", "newColValues"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"newColValues", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"periodNumber", "[", 
              RowBox[{
               RowBox[{"StringSplit", "[", "#", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}], "/@", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"newCol", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<SETTLEMENT_PERIOD\>\"", ",", " ", "newColValues"}], 
             "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Insert", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", "data", "]"}], ",", "newCol", ",", 
             "2"}], "]"}], "//", "Transpose"}]}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"addNewColumn2", "[", "data_", "]"}], ":=", 
       RowBox[{"Module", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"newCol", ",", "newColValues"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"newColValues", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"FromDateString", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"StringSplit", "[", "#", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"TimeZone", "->", "None"}]}], "]"}], "&"}], "/@", 
            RowBox[{"data", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", ";;"}], ",", "1"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"newCol", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<SETTLEMENT_DATE\>\"", ",", " ", "newColValues"}], 
             "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Insert", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", "data", "]"}], ",", "newCol", ",", 
             "2"}], "]"}], "//", "Transpose"}]}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"convertToDataset", "[", "data_", "]"}], ":=", 
       RowBox[{
        RowBox[{"Dataset", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AssociationThread", "[", 
            RowBox[{
             RowBox[{"data", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "\[Rule]", "#"}], "]"}], "&"}], 
          "/@", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"2", ";;"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"RightComposition", "[", "\[IndentingNewLine]", 
       RowBox[{
       "addNewColumn1", ",", "\[IndentingNewLine]", "addNewColumn2", ",", 
        "\[IndentingNewLine]", "convertToDataset"}], "\[IndentingNewLine]", 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
