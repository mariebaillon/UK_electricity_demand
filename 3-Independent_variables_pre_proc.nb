Cell["\<\
There is a build in Kruskal-Wallis test in Mathematica.
There is a statistically significant difference between E and W temperatures.\
\>", "Text",
 CellChangeTimes->{{3.926998017428135*^9, 3.926998066960097*^9}, {
  3.926998247401005*^9, 3.926998279918112*^9}, {3.9269988372016907`*^9, 
