Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "function", " ", "creates", " ", "a", " ", "table", " ", 
     "for", " ", "all", " ", "the", " ", "fields", " ", "in", " ", "the", " ", 
     RowBox[{"dataset", ".", " ", "For"}], " ", "numerical", " ", "data"}], 
    ",", " ", 
    RowBox[{"it", " ", "summarises", " ", "\"\<mean\>\""}], ",", 
    "\"\<std dev\>\"", ",", "\"\<min\>\"", ",", "\"\<median\>\"", ",", 
    "\"\<max\>\"", ",", "\"\<count of NA\>\"", ",", "\"\<quantile 25%\>\"", 
    ",", 
    RowBox[{"\"\<quantile 50%\>\"", " ", "and", " ", 
     RowBox[{"\"\<quantile 75%\>\"", ".", " ", "For"}], " ", "categorical", 
     " ", "data"}], ",", " ", 
    RowBox[{
    "it", " ", "summarises", " ", "the", " ", "different", " ", "categories", 
     " ", "and", " ", "\"\<count of NA\>\""}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"statsSummary", "[", "dataset_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "keys", ",", "keysCat", ",", "keysNum", ",", "\[IndentingNewLine]", 
       "summary1", ",", "summary2", ",", "summaryNumDS", ",", "summary3", ",",
        "summaryCatDS"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"keys", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Keys", "[", "dataset", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "//", "Normal"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"keysCat", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"keysNum", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dataset", "[", 
              RowBox[{"All", ",", "#"}], "]"}], "//", "DeleteMissing"}], ",", 
            "NumericQ"}], "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"keysNum", ",", "#"}], "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"keysCat", ",", "#"}], "]"}]}], "]"}], "&"}], "/@", 
       "keys"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"summary1", "[", "key_", "]"}], ":=", 
       RowBox[{
        RowBox[{"Query", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Mean", "/*", "N"}], ",", 
            RowBox[{"StandardDeviation", "/*", "N"}], ",", "Min", ",", 
            "Median", ",", "Max", ",", 
            RowBox[{"Count", "[", "_Missing", "]"}]}], "}"}], ",", "key"}], 
         "]"}], "[", "dataset", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"summary2", "[", "key_", "]"}], ":=", 
       RowBox[{"Quantile", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dataset", "[", 
           RowBox[{"All", ",", "key"}], "]"}], "//", "DeleteMissing"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"1", "/", "2"}], ",", 
           RowBox[{"3", "/", "4"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"summaryNumDS", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"<|", 
           RowBox[{"#", "->", 
            RowBox[{"(", 
             RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "\"\<mean\>\"", ",", "\"\<std dev\>\"", ",", "\"\<min\>\"", 
                 ",", "\"\<median\>\"", ",", "\"\<max\>\"", ",", 
                 "\"\<count#NA\>\"", ",", "\"\<quantile25\>\"", ",", 
                 "\"\<quantile50\>\"", ",", "\"\<quantile75\>\""}], "}"}], "->",
                "\[IndentingNewLine]", 
               RowBox[{"Flatten", "[", 
                RowBox[{"Append", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"summary1", "[", "#", "]"}], "//", "Normal"}], ",", 
                  RowBox[{
                   RowBox[{"summary2", "[", "#", "]"}], "//", "Normal"}]}], 
                 "]"}], "]"}]}], "]"}], ")"}]}], "|>"}], "&"}], "/@", 
         "keysNum"}], "//", "Dataset"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"summary3", "[", "key_", "]"}], ":=", 
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"MissingQ", "[", "#", "]"}], ",", "\"\<count#NA\>\"", 
               ",", "#"}], "]"}], "&"}], "/@", 
            RowBox[{"Keys", "[", 
             RowBox[{
              RowBox[{"Query", "[", 
               RowBox[{"Counts", ",", "key"}], "]"}], "[", "dataset", "]"}], 
             "]"}]}], "]"}], "->", 
          RowBox[{"Normal", "[", 
           RowBox[{"Values", "[", 
            RowBox[{
             RowBox[{"Query", "[", 
              RowBox[{"Counts", ",", "key"}], "]"}], "[", "dataset", "]"}], 
            "]"}], "]"}]}], "]"}], "//", "Dataset"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"summaryCatDS", "=", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "->", 
             RowBox[{"summary3", "[", "#", "]"}]}], "&"}], "/@", "keysCat"}], 
          "//", "Normal"}], "|>"}], "//", "Dataset"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<rows\>\"", "->", 
          RowBox[{
           RowBox[{"Dimensions", "[", "dataset", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<total#NA\>\"", "->", 
          RowBox[{"Length", "@", 
           RowBox[{"Select", "[", 
            RowBox[{"dataset", ",", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"#", ",", 
                RowBox[{"Missing", "[", "]"}]}], "]"}], "&"}]}], "]"}]}]}], 
         ",", "\[IndentingNewLine]", "summaryNumDS", ",", 
         "\[IndentingNewLine]", "summaryCatDS"}], "}"}], "//", 
       "TableForm"}]}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
