  3.9310819040567455`*^9}},ExpressionUUID->"406849b1-4a44-f546-aaa9-\
978ae98e13f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"LocationEquivalenceTest", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tempE", ",", "tempW"}], "}"}], ",", "\"\<KruskalWallis\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"LocationEquivalenceTest", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tempE", ",", "tempW"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<TestDataTable\>\"", ",", "All"}], "}"}]}], "]"}]}], "Input",
