Cell[BoxData[
 RowBox[{
  RowBox[{"mape", "[", 
   RowBox[{"prediction_", ",", "actual_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"APE", ",", "n", ",", "MAPE"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "actual", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"APE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"100", " ", "*", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"actual", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"prediction", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"actual", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MAPE", "=", 
      RowBox[{"Mean", "[", "APE", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.930627943768553*^9, 3.9306282162728043`*^9}, {
  3.93064135324296*^9, 3.930641381371151*^9}, {3.930641999065479*^9, 
  3.930641999427908*^9}, {3.930644120454956*^9, 3.930644124570578*^9}, {
  3.9306574187664433`*^9, 3.930657470114477*^9}, {3.930805517885889*^9, 
  3.9308055247827*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"6c810924-3482-0c45-9e13-34e2e748462e"]
}, Open  ]],

