Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Name of variable\>\"", ",", "\"\<Series regularly sampled?\>\"", 
       ",", "\"\<Series auto-correlated?\>\"", ",", 
       "\"\<Series stationary?\>\""}], "}"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"variablesName", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"RegularlySampledQ", "[", 
         RowBox[{"variables", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AutocorrelationTest", "[", 
            RowBox[{"variables", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "<", "0.05"}], ",", 
          "True", ",", " ", "False"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"UnitRootTest", "[", 
            RowBox[{"variables", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "<", "0.05"}], ",", 
          "True", ",", "False"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "variables", "]"}]}], "}"}]}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.930135570935663*^9, 3.930135573702091*^9}, {
  3.930135606255953*^9, 3.9301357237297287`*^9}, {3.930135772509781*^9, 
