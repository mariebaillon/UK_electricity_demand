Cell[CellGroupData[{

Cell["2 Extract yearly trend: Low pass Gaussian filter", "Section",
 CellChangeTimes->{{3.929433328768637*^9, 3.929433335982043*^9}, {
   3.9294375812785625`*^9, 3.929437588287861*^9}, {3.930626937155258*^9, 
   3.930626945841027*^9}, {3.930725650166193*^9, 3.9307256520591335`*^9}, {
