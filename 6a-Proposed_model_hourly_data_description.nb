Cell["\<\
A shift of time shift of 5 or 6 time steps with 2 Fourier components \
minimises the error.
Let\[CloseCurlyQuote]s then confirm the number of Fourier components needed \
to fit the time series.\
\>", "Text",
 CellChangeTimes->{{3.930886475215408*^9, 3.930886535715084*^9}, 
   3.93133679994343*^9, {3.9321102934103527`*^9, 
   3.932110351837982*^9}},ExpressionUUID->"6eea40e0-dd0d-3a45-a6e6-\
5e3f7e0a2a85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"mape", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"forecastCyclic2", "[", 
             RowBox[{"#", ",", "n"}], "]"}], ")"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
