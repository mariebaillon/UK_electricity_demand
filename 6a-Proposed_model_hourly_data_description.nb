Cell[CellGroupData[{

Cell["\<\
3.4.1 Cyclic model 1 - fully defined by phase, amplitude and frequency\
\>", "Subsubsection",
 CellChangeTimes->{{3.929519100954061*^9, 3.929519101681818*^9}, {
   3.930139571094139*^9, 3.930139592278839*^9}, {3.930644492619575*^9, 
   3.930644493293207*^9}, {3.930725752216807*^9, 3.93072575451062*^9}, {
   3.931599346917805*^9, 3.931599352630329*^9}, 3.9320363324650173`*^9, {
   3.9327360015537987`*^9, 3.9327360056266003`*^9}, 
   3.9573434192608757`*^9},ExpressionUUID->"66698832-9bf3-0c49-80a6-\
c073065a24e7"],

Cell["\<\
We work with a single-sided spectrum. To do that we took the first half of \
the two-sided spectrum. Multiply the spectrum in the positive frequencies by \
2. The first and last frequencies are not multiplied by 2 as these amplitudes \
correspond to the zero and Nyquist frequencies, respectively, and they do not \
have the complex conjugate pairs in the negative frequencies.\
\>", "Text",
 CellChangeTimes->{{3.930909395230398*^9, 3.930909413544985*^9}, 
   3.930909473344105*^9, {3.931257021638382*^9, 
   3.9312571596427135`*^9}},ExpressionUUID->"1ca540ec-145e-554a-bbf2-\
6b9d25004e84"],

Cell["The frequencies are sorted by amplitude.", "Text",
 CellChangeTimes->{{3.9312571800156994`*^9, 
  3.9312572099650917`*^9}},ExpressionUUID->"8900a4dc-13f7-284a-896e-\
0b40b33d5424"],

